                <mxCell id="CVSmJpeon_8mGstqPoIp-84" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;public double CalcularCuotaSocio(Socio socio){&lt;/span&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;return socio.CalcularCuotaPura()&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;}&lt;/div&gt;" vertex="1">
