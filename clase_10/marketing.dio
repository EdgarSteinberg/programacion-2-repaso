                <mxCell id="53" value="#ListaPrecio&lt;div&gt;public void Imprimier()&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;console.writeline($`Lista precio: {this,Nombre} - vigencia {this.vigencia}&lt;/div&gt;&lt;div&gt;forEach(var art in _articulos)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;console.writeLine(art.LineaDetalle())&lt;br&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d6b656;fillColor=#fff2cc;" vertex="1" parent="1">
