                </mxCell>
                <mxCell id="54" value="#Articulo&lt;div&gt;public string LineaDetalle()&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;return $&quot;Articulo {this.Nombre} precio {this.costo())&quot;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#9673a6;fillColor=#e1d5e7;" vertex="1" parent="1">
                    <mxGeometry x="410" y="33" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="55" value="#promocion&lt;div&gt;public override double Costo()&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;double costo = 0;&lt;/div&gt;&lt;div&gt;forEach(var producto in productos)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;costo += prod.CostoProducto();&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;return costo;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#d79b00;fillColor=#ffe6cc;" vertex="1" parent="1">
                    <mxGeometry x="480" y="338" width="210" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="56" value="#PromocionProducto&lt;div&gt;public double Costo()&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;return this.cantidad * this.producto.Costo()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#6c8ebf;fillColor=#dae8fc;" vertex="1" parent="1">
