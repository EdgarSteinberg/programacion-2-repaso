                <mxCell id="pVztxgi3BJyKxwhJAuHt-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;#Hambrienta&lt;/div&gt;public void Comer(Mascota m){&lt;div&gt;return M.Cambiarestado(new Contenta);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;public void Juega(Mascota m){&lt;/div&gt;&lt;div&gt;return &#39;La mascota no puede jugar porque esta aburrida&#39;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;public bool PuedeJugar(){&lt;/div&gt;&lt;div&gt;return false;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
                    <mxGeometry height="174" width="260" x="-174" y="266" as="geometry"/>
                </mxCell>
                <mxCell id="pVztxgi3BJyKxwhJAuHt-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;#Contenta&lt;/div&gt;public void Comer(Mascota m){&lt;div&gt;return M.nivelContanta += 1;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;public void Jugar(Mascota m){&lt;/div&gt;&lt;div&gt;return M.nivelContenta += 2;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;public bool PuedeJugar(){&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;return true;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;}&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="225.5" x="337" y="304" as="geometry"/>
                </mxCell>
                <mxCell id="pVztxgi3BJyKxwhJAuHt-43" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;rounded=0;" value="&lt;div&gt;#Aburrida&lt;/div&gt;public void Comer(Mascota m){&lt;div&gt;if(m.MinutosAburrida &amp;gt; 80){&lt;/div&gt;&lt;div&gt;return M.CambiarEstado(new Contenta())&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;public void Jugar(Mascota M){&lt;/div&gt;&lt;div&gt;return M.estado = Contenta&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;public bool PuedeJugar(){&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;return true;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(78, 86, 102, 0.38) rgb(22, 25, 29);&quot;&gt;}&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="210" width="252.5" x="580" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="pVztxgi3BJyKxwhJAuHt-47" edge="1" parent="1" source="pVztxgi3BJyKxwhJAuHt-10" style="edgeStyle=none;html=1;entryX=0.571;entryY=0.98;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=0;dashed=1;" target="pVztxgi3BJyKxwhJAuHt-8">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pVztxgi3BJyKxwhJAuHt-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=0;" value="#Mascota&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;public void Jugar(){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;estado.jugar(this)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;public void Comer(){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;estado.comer(this)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;public bool PuedeJugar(){&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;return estado,PuedeJuegar();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;}&lt;br&gt;&lt;/font&gt;&lt;div&gt;public void&amp;nbsp; CambiarEstado(ICambiarEstado nueviEstado){&lt;/div&gt;&lt;div&gt;return estado = nuevoEstado;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;" vertex="1">
